# =========================================================================
# Site web Aéroport International de N'djili (FIH)
# Variables d'environnement — copier vers .env et remplir
# =========================================================================
# /!\ NE JAMAIS commiter le .env réel. Seul .env.example est versionné.
# =========================================================================

# -- FRONTEND (Vite — préfixe VITE_) ---------------------------------------
# Supabase (projet existant — récupérer depuis app.supabase.com → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FlightAware (ou AviationStack) — données vols temps réel
VITE_AVIATIONSTACK_KEY=your_aviationstack_api_key_here
VITE_FLIGHTAWARE_API_KEY=

# MapLibre / MapTiler — plans aérogare et localisation FIH
VITE_MAPLIBRE_KEY=

# Plausible Analytics (RGPD-friendly)
VITE_PLAUSIBLE_DOMAIN=fih.cd

# -- BACKEND / EDGE FUNCTIONS (jamais exposé côté client) ------------------
# Supabase service_role (admin) — UNIQUEMENT serveur / Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# Mobile Money — APIs paiement stationnement
AIRTEL_MONEY_API_KEY=
MPESA_API_KEY=
ORANGE_MONEY_API_KEY=

# SMS — alertes vols (Africa's Talking ou Twilio)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Email transactionnel
RESEND_API_KEY=

# Vols temps réel (côté serveur — synchronisation cron)
FLIGHTAWARE_API_KEY=
